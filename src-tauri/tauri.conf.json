{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Codex Quota Tracker",
  "version": "0.1.7",
  "identifier": "app.codexquotatracker.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "title": "Codex Quota Tracker",
      "width": 390,
      "height": 590,
      "minWidth": 390,
      "minHeight": 380,
      "maxWidth": 390,
      "maxHeight": 590,
      "center": false,
      "resizable": false,
      "fullscreen": false,
      "transparent": false,
      "decorations": false,
      "visible": false,
      "skipTaskbar": true,
      "alwaysOnTop": true
    }],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app", "msi", "nsis"],
    "icon": ["icons/icon.icns", "icons/icon.ico", "icons/128x128.png", "icons/128x128@2x.png"],
    "externalBin": ["binaries/codex"],
    "copyright": "Copyright © 2026 Codex Quota Tracker contributors",
    "category": "Utility",
    "shortDescription": "Local-first Codex quota and WorkBuddy points tracker",
    "macOS": { "minimumSystemVersion": "12.0", "signingIdentity": "-" },
    "windows": { "certificateThumbprint": null, "digestAlgorithm": "sha256" }
  }
}
